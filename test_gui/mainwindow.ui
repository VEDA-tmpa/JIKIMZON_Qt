           <widget class="QPushButton" name="searchButton">
            <property name="styleSheet">
             <string notr="true">/* OK 버튼 스타일 */
QPushButton{
    background-color: rgba(255, 255, 255, 100);  /* 밝은 회색 */
    color: rgb(0, 0, 0);             /* 글자색 검정 */
    font-size: 13px;            /* 글자 크기 */
    font-weight: bold;
    border-radius: 5px;         /* 모서리를 살짝 둥글게 */
    padding: 10px 20px;          /* 버튼 안쪽 여백 */
}

/* OK 버튼 hover 효과 */
QPushButton:hover {
    background-color:  rgba(170, 201, 227, 50);
}</string>
            </property>
            <property name="text">
             <string>검색</string>
            </property>
           </widget>
          </item>
          <item row="1" column="0" colspan="3">
           <widget class="QTableView" name="tableView">
            <property name="styleSheet">
             <string notr="true">/* QTableView 기본 스타일 */
QTableView {
          background-color: rgba(255, 255, 255, 100);
        border-radius: 10px;
    gridline-color: #a8c5da;    /* 그리드라인 색상 */
    color: #436f90;             /* 텍스트 색상 */
}

/* QTableView 아이템 스타일 */
QTableView::item {
    padding: 6px;               /* 항목의 여백 */
    border: 1px solid transparent;  /* 항목의 기본 테두리 색상 */
    color: #436f90;             /* 항목 텍스트 색상 */
}

QTableView::item:selected {
   background-color:  rgba(170, 201, 227, 80);
    color: #436f90;             /* 선택된 항목 텍스트 색상 */
}

QTableView::item:hover {
    background-color:  rgba(170, 201, 227, 80);
    color: #436f90;             /* 호버 시 항목 텍스트 색상 */
}

/* QTableView 수평 헤더 스타일 */
QTableView::horizontalHeader {
    background-color: rgba(92, 141, 177, 150); /* 헤더 배경 색상 */
    color: #ffffff;             /* 헤더 텍스트 색상 */
    font-weight: bold;          /* 헤더 텍스트 굵게 */
    padding: 4px;               /* 헤더 텍스트 여백 */
    border-bottom: 2px solid #a8c5da; /* 헤더 하단 테두리 */
}

/* 스크롤바 스타일 */
QScrollBar:vertical {
    border: none;
    background: rgba(176, 227, 255, 100); /* 스크롤바 배경 */
    width: 12px;                       /* 스크롤바 너비 */
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: rgba(92, 141, 177, 80); /* 스크롤바 핸들 */
    min-height: 20px;                        /* 핸들 최소 높이 */
    border-radius: 6px;                      /* 모서리 둥글게 */
}

QScrollBar::add-line:vertical, 
QScrollBar::sub-line:vertical {
    height: 0px;
    subcontrol-position: top;
    subcontrol-origin: margin;
}

QScrollBar::up-arrow:vertical, 
QScrollBar::down-arrow:vertical {
    background: none;
}

QScrollBar::add-page:vertical, 
QScrollBar::sub-page:vertical {
    background: none;
}

</string>
            </property>
