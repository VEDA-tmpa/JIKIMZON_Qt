           <widget class="QLineEdit" name="eventlineEdit">
            <property name="styleSheet">
             <string notr="true">/* QLineEdit 기본 스타일 */
QLineEdit {
    background-color: rgba(255, 255, 255, 100);  /* 배경 색상 */
    border-radius: 5px;         /* 모서리 둥글게 */
    padding: 10px;               /* 내부 여백 */
    font-size: 13px;            /* 텍스트 크기 */
    color: #333333;             /* 텍스트 색상 */
}

/* QLineEdit 포커스 시 스타일 (기본 상태로 둡니다) */
QLineEdit:focus {
background-color:  rgba(170, 201, 227, 50);
}
</string>
            </property>
           </widget>
          </item>
          <item row="0" column="0">
           <widget class="QComboBox" name="eventcomboBox">
            <property name="styleSheet">
             <string notr="true">/* QComboBox 기본 스타일 */
QComboBox {
    background-color: rgba(255, 255, 255, 100);  
    border-radius: 10px;         /* 모서리 둥글게 */
    padding: 10px;              /* 내부 여백 */
    font-size: 13px;            /* 텍스트 크기 */
    color: #333333;             /* 텍스트 색상 */
}

/* QComboBox 항목 호버 시 색상 */
QComboBox::hover {
      background-color:  rgba(170, 201, 227, 50);
}

/* QComboBox 항목 선택 시 색상 */
QComboBox::item:selected {
    background-color:     background-color:  rgba(170, 201, 227, 100);
    color: #436f90;             /* 선택된 항목 텍스트 색상 */
}

/* QComboBox 화살표 아이콘 투명하게 설정 */
QComboBox::down-arrow {
    width: 18px;                         /* 화살표 크기 조정 */
    height: 18px;
    background-color: rgba(0, 0, 0, 0);  /* 화살표 배경 투명 */
}

/* QComboBox 팝업 목록에 대한 스타일 (항목 선택 시 팝업 배경 색상) */
QComboBox QAbstractItemView {
    background-color: #FFFFFF;  /* 팝업 배경 색상 */
    selection-background-color: #5C8DB1; /* 선택된 항목 배경 색상 */
    selection-color: rgba(170, 201, 227, 50);
    color: #333333;             /* 텍스트 색상 */
}
</string>
