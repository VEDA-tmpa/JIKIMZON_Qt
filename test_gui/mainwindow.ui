     <property name="styleSheet">
      <string notr="true">QPushButton {
    background-color: transparent; /* 버튼 배경을 투명하게 설정 */
    color: black; /* 기본 텍스트 색상은 검은색 */
    font-weight: bold; /* 텍스트를 두껍게 설정 */
    font-size: 15px; /* 텍스트 크기 설정 (여기서 15px로 시작) */
    border: none; /* 버튼 테두리 없앰 */
}

QPushButton:hover {
    background-color: #B8E9FF; /* 호버 시 배경색을 연한 파랑(#B8E9FF)으로 설정 */
    color: black; /* 호버 시 텍스트 색상 유지 */
    font-size: 18px; /* 호버 시 텍스트 크기를 18px로 설정 (필요에 따라 조정 가능) */
}
</string>
