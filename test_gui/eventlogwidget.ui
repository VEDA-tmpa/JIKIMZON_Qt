}

/* QFrame 내부의 QLabel 스타일 */
QFrame QLabel {
    color: #333333;             /* 텍스트 색상 */
    font-size: 18px;            /* 텍스트 크기 */
    font-weight: bold;          /* 텍스트 굵기 */
}

/* QFrame 내부의 QPushButton 스타일 */
QFrame QPushButton {
    background-color: #0078D7;  /* 버튼 배경 색상 */
    color: white;               /* 버튼 텍스트 색상 */
    border: none;               /* 버튼 테두리 없애기 */
    border-radius: 5px;         /* 버튼 모서리 둥글게 */
    padding: 10px 20px;         /* 버튼 패딩 */
}

QFrame QPushButton:hover {
    background-color: #005BB5;  /* 마우스 오버 시 색상 */
}

QFrame QPushButton:pressed {
    background-color: #003F8A;  /* 버튼 클릭 시 색상 */
}

/* QFrame 내부의 QLineEdit 스타일 */
QFrame QLineEdit {
    background-color: rgba(240, 240, 240, 180); /* 배경 색상 (연한 회색, 투명도 포함) */
    border: 1px solid #D0D0D0;  /* 테두리 색상 */
    border-radius: 5px;         /* 모서리 둥글게 */
    padding: 10px;              /* 내부 여백 */
    font-size: 16px;            /* 텍스트 크기 */
    color: #333333;             /* 텍스트 색상 */
}

/* QFrame 내부의 QListView 스타일 */
QFrame QListView {
    border: 1px solid #D0D0D0;  /* 테두리 색상 */
    border-radius: 3px;         /* 모서리 둥글게 */
}
