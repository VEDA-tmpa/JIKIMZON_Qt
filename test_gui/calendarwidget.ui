/* 캘린더 스타일 */
QCalendarWidget {
    background-color: rgba(255, 255, 255, 100); /* 캘린더 배경 투명 */
    border-radius: 20px;        /* 모서리 둥글게 */
    padding: 16px;              /* 내부 여백 */
}

/* 캘린더 버튼 스타일 */
QCalendarWidget QToolButton {
    color: #333; /* 툴바 버튼 텍스트 색상 */
