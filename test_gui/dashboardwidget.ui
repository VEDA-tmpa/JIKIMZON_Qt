        <property name="styleSheet">
         <string notr="true">QListWidget {
    background-color: rgba(255, 255, 255, 100);  /* 배경 색상과 투명도 (180은 0~255 사이의 값으로 투명도를 설정) */
    border-radius: 15px;        /* 모서리 둥글게 */
    padding: 16px;              /* 내부 여백 */
        font-size: 14px;            /* 폰트 크기 */
    }

    QListWidget::item {
        padding: 5px;
        background-color: transparent;  /* 항목 배경 */
        border-bottom: 1px solid #e0e0e0;  /* 항목 사이에 경계선 */
    }

    QListWidget::item:hover {
        background-color: #d3d3d3;  /* 마우스 호버 시 배경색 */
    }

    QListWidget::item:selected {
        background-color:  rgba(67, 111, 144, 100);/* 선택된 항목 배경색 */
        color: white;               /* 선택된 항목 텍스트 색 */
    }

    QListWidget::item:selected:!active {
        background-color: #3e8e41;  /* 선택된 항목이 비활성일 때 색상 */
    }

/* 세로 스크롤바 스타일 */
QScrollBar:vertical {
    border: none;
    background: rgba(176, 227, 255, 100); /* 스크롤바 배경: #3b3b3b에 투명도 50% */
    width: 12px;                       /* 스크롤바 너비 */
    margin: 0px 0px 0px 0px;
}

QScrollBar::handle:vertical {
    background-color:  rgba(176, 227, 255, 100); /* 스크롤바 핸들: #3b3b3b에 투명도 80% */
    min-height: 20px;                        /* 핸들의 최소 높이 */
    border-radius: 6px;                      /* 모서리 둥글게 */
}

QScrollBar::add-line:vertical, 
QScrollBar::sub-line:vertical {
    height: 0px;
    subcontrol-position: top;
    subcontrol-origin: margin;
}

QScrollBar::up-arrow:vertical, 
QScrollBar::down-arrow:vertical {
    background: none;
}

QScrollBar::add-page:vertical, 
QScrollBar::sub-page:vertical {
    background: none;
}

</string>
        </property>
