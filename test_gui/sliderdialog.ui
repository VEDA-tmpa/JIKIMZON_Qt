   <property name="styleSheet">
    <string notr="true">/* OK 버튼 스타일 */
QPushButton#okButton {
    background-color: #D3D3D3;  /* 밝은 회색 */
    color: #000000;             /* 글자색 검정 */
    font-size: 13px;            /* 글자 크기 */
    font-weight: bold;
    border: 1px solid #A9A9A9;  /* 진한 회색 테두리 */
    border-radius: 5px;         /* 모서리를 살짝 둥글게 */
    padding: 5px 15px;          /* 버튼 안쪽 여백 */
}

/* OK 버튼 hover 효과 */
QPushButton#okButton:hover {
    background-color: #BEBEBE;  /* 더 진한 회색 */
}</string>
   </property>
