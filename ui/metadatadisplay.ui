      <item row="1" column="1">
       <widget class="QLabel" name="locationLabel">
        <property name="styleSheet">
         <string notr="true">QLabel {
        color: #333333;                /* 텍스트 색상 */
    background-color: rgba(255, 255, 255, 100);  /* 배경 색상과 투명도 (180은 0~255 사이의 값으로 투명도를 설정) */
        padding: 10px;                 /* 내부 여백 */
        font-size: 13px;               /* 폰트 크기 */
        font-family: Arial, sans-serif;/* 폰트 종류 */
        font-weight: bold;             /* 폰트 굵기 */
        text-align: center;            /* 텍스트 정렬 */
        border-radius: 5px;            /* 테두리 둥글기 */
    }

    QLabel:hover {
        background-color: #e0e0e0;     /* 마우스를 올렸을 때 배경색 */
    }

    QLabel:focus {
        border: 2px solid #4CAF50;     /* 포커스 시 테두리 색상 */
    }</string>
        </property>
        <property name="text">
         <string>위치: </string>
        </property>
