    <property name="styleSheet">
     <string notr="true">QPushButton {
    background-color: rgb(229, 231, 158); /* 배경색 */
    border: 2px solid rgb(69, 61, 53); /* 테두리 색상과 두께 */
    border-radius: 25px; /* 버튼 크기의 절반으로 설정 (정확한 원형) */
    color: white; /* 텍스트 색상 */
    font-size: 15px; /* 텍스트 크기 */
    width: 30px; /* 버튼의 너비 */
    height: 30px; /* 버튼의 높이 */
}

QPushButton:hover {
    background-color: rgb(170, 197, 227); /* 호버 상태 배경색 */
}

QPushButton:pressed {
    background-color: rgb(252, 253, 248); /* 클릭 시 배경색 */
}</string>
