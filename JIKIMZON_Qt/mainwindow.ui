    <property name="styleSheet">
     <string notr="true">/* 전체 탭 위젯 배경색 */
QTabWidget::pane {
    background-color: rgb(255, 255, 255);
    border: 1px solid #535366;
    border-radius: 5px;
}

/* 탭 바 스타일 설정 (탭 버튼 영역) */
QTabBar::tab {
    background-color: rgb(240, 240, 240); /* 기본 탭 배경 */
    color: rgb(28, 28, 28);               /* 탭 텍스트 색상 */
    padding: 5px;
    border: 1px solid #535366;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

/* 선택된 탭 스타일 */
QTabBar::tab:selected {
    background-color: rgb(255, 255, 255); /* 선택된 탭 배경 */
    font-weight: bold;                     /* 선택된 탭 굵은 글씨 */
    color: black;
}

/* 비활성 탭 스타일 */
QTabBar::tab:!selected {
    background-color: rgb(230, 230, 230); /* 비활성 탭 배경 */
}

/* 탭 바의 간격 조정 */
QTabBar::tab {
    margin-right: 2px;
}
</string>
