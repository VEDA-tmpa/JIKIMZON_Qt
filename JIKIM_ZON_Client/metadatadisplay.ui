        padding: 5px;
        background-color: transparent;  /* 항목 배경 */
        border-bottom: 1px solid #e0e0e0;  /* 항목 사이에 경계선 */
    }

    QListWidget::item:hover {
        background-color: #d3d3d3;  /* 마우스 호버 시 배경색 */
    }

    QListWidget::item:selected {
        background-color: #4CAF50;  /* 선택된 항목 배경색 */
        color: white;               /* 선택된 항목 텍스트 색 */
    }

    QListWidget::item:selected:!active {
        background-color: #3e8e41;  /* 선택된 항목이 비활성일 때 색상 */
    }</string>
